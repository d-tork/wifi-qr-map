# Copy to wifi.env (gitignored) or export these in your shell. Never commit real values.
WIFI_SSID=Alexandria Guest
WIFI_PASSWORD=change-me
# WPA covers WPA/WPA2/WPA3-transition networks; SAE only for WPA3-only; WEP; nopass
WIFI_SECURITY=WPA
WIFI_HIDDEN=false
# Legend (fallback text printed on the map, unlabelled). Defaults: the real values.
# WIFI_LEGEND_NETWORK_TEXT=Alexandria Guest
# WIFI_LEGEND_PASSWORD_TEXT=ask at the bar
